{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-language" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fas fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fas fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fas fa-pencil-alt"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-language" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="checkbox" name="language_russian_status" value="1" id="input-status" class="form-check-input"{% if language_russian_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <fieldset>
            <legend>{{ text_default }}</legend>
            <div class="row mb-3">
              <label for="input-preset" class="col-sm-2 col-form-label">{{ entry_preset }}</label>
              <div class="col-sm-10">
                <select name="language_russian_preset" id="input-preset" class="form-select">
                  <option value="">{{ text_preset_none }}</option>
                  {% for preset in presets %}
                    <option value="{{ preset.code }}"{% if preset_selected == preset.code %} selected{% endif %}>{{ preset.name }}</option>
                  {% endfor %}
                </select>
                <div class="form-text">{{ help_preset }}</div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-default-country" class="col-sm-2 col-form-label">{{ entry_preset_country }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="checkbox" name="language_russian_default_country" value="1" id="input-default-country" class="form-check-input"{% if preset_active.country %} checked{% endif %}/>
                  <label for="input-default-country" class="form-check-label">{{ text_value_country }}</label>
                </div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-preset-zone" class="col-sm-2 col-form-label">{{ entry_preset_zone }}</label>
              <div class="col-sm-10">
                <select name="language_russian_zone_id" id="input-preset-zone" class="form-select">
                  <option value="">{{ text_zone_select }}</option>
                  {% for zone in zones %}
                    <option value="{{ zone.zone_id }}"{% if zone.zone_id == preset_zone_id %} selected{% endif %}>{{ zone.name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-default-timezone" class="col-sm-2 col-form-label">{{ entry_preset_timezone }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="checkbox" name="language_russian_default_timezone" value="1" id="input-default-timezone" class="form-check-input"{% if preset_active.timezone %} checked{% endif %}/>
                  <label for="input-default-timezone" class="form-check-label">{{ text_value_timezone }}</label>
                </div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-default-language" class="col-sm-2 col-form-label">{{ entry_preset_language }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="checkbox" name="language_russian_default_language" value="1" id="input-default-language" class="form-check-input"{% if preset_active.language %} checked{% endif %}/>
                  <label for="input-default-language" class="form-check-label">{{ text_value_language }}</label>
                </div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-default-language-admin" class="col-sm-2 col-form-label">{{ entry_preset_language_admin }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="checkbox" name="language_russian_default_language_admin" value="1" id="input-default-language-admin" class="form-check-input"{% if preset_active.language_admin %} checked{% endif %}/>
                  <label for="input-default-language-admin" class="form-check-label">{{ text_value_language_admin }}</label>
                </div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-default-currency" class="col-sm-2 col-form-label">{{ entry_preset_currency }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="checkbox" name="language_russian_default_currency" value="1" id="input-default-currency" class="form-check-input"{% if preset_active.currency %} checked{% endif %}/>
                  <label for="input-default-currency" class="form-check-label">{{ text_value_currency }}</label>
                </div>
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
var presetZoneIds = {{ preset_zone_ids|json_encode|raw }};

$('#input-preset').on('change', function() {
    var code = $(this).val();
    var enabled = code !== '';

    $('#input-default-country, #input-default-timezone, #input-default-language, #input-default-language-admin, #input-default-currency').prop('checked', enabled);

    if (code === 'russia') {
        $('#input-preset-zone').val('');
    } else if (presetZoneIds[code]) {
        $('#input-preset-zone').val(String(presetZoneIds[code]));
    }
});
//--></script>
{{ footer }}
