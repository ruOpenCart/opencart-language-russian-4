{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-language" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fas fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fas fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fas fa-pencil-alt"></i> {{ text_edit }}</div>
      <div class="card-body">
        <ul class="nav nav-tabs">
          <li class="nav-item"><a href="#tab-status" data-bs-toggle="tab" class="nav-link active">{{ tab_status }}</a></li>
          <li class="nav-item"><a href="#tab-setting" data-bs-toggle="tab" class="nav-link">{{ tab_setting }}</a></li>
          <li class="nav-item"><a href="#tab-translation" data-bs-toggle="tab" class="nav-link">{{ tab_translation }}</a></li>
        </ul>
        <div class="tab-content">
            <div id="tab-status" class="tab-pane active">
              <form id="form-language" action="{{ save }}" method="post" data-oc-toggle="ajax">
              <div class="row mb-3 mt-3">
                <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="checkbox" name="language_russian_status" value="1" id="input-status" class="form-check-input"{% if language_russian_status %} checked{% endif %}/>
                  </div>
                </div>
              </div>
              </form>
            </div>
            <div id="tab-setting" class="tab-pane">
              <fieldset class="mt-3">
                <legend>{{ text_default }}</legend>
                <div class="row mb-3">
                  <label for="input-preset" class="col-sm-2 col-form-label">{{ entry_preset }}</label>
                  <div class="col-sm-10">
                    <select name="language_russian_preset" id="input-preset" class="form-select" form="form-language">
                      <option value="">{{ text_preset_none }}</option>
                      {% for preset in presets %}
                        <option value="{{ preset.code }}"{% if preset_selected == preset.code %} selected{% endif %}>{{ preset.name }}</option>
                      {% endfor %}
                    </select>
                    <div class="form-text">{{ help_preset }}</div>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-default-country" class="col-sm-2 col-form-label">{{ entry_preset_country }}</label>
                  <div class="col-sm-10">
                    <div class="form-check form-switch form-switch-lg">
                      <input type="checkbox" name="language_russian_default_country" value="1" id="input-default-country" class="form-check-input" form="form-language"{% if preset_active.country %} checked{% endif %}/>
                      <label for="input-default-country" class="form-check-label">{{ text_value_country }}</label>
                    </div>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-preset-zone" class="col-sm-2 col-form-label">{{ entry_preset_zone }}</label>
                  <div class="col-sm-10">
                    <select name="language_russian_zone_id" id="input-preset-zone" class="form-select" form="form-language">
                      <option value="">{{ text_zone_select }}</option>
                      {% for zone in zones %}
                        <option value="{{ zone.zone_id }}"{% if zone.zone_id == preset_zone_id %} selected{% endif %}>{{ zone.name }}</option>
                      {% endfor %}
                    </select>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-default-timezone" class="col-sm-2 col-form-label">{{ entry_preset_timezone }}</label>
                  <div class="col-sm-10">
                    <div class="form-check form-switch form-switch-lg">
                      <input type="checkbox" name="language_russian_default_timezone" value="1" id="input-default-timezone" class="form-check-input" form="form-language"{% if preset_active.timezone %} checked{% endif %}/>
                      <label for="input-default-timezone" class="form-check-label">{{ text_value_timezone }}</label>
                    </div>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-default-language" class="col-sm-2 col-form-label">{{ entry_preset_language }}</label>
                  <div class="col-sm-10">
                    <div class="form-check form-switch form-switch-lg">
                      <input type="checkbox" name="language_russian_default_language" value="1" id="input-default-language" class="form-check-input" form="form-language"{% if preset_active.language %} checked{% endif %}/>
                      <label for="input-default-language" class="form-check-label">{{ text_value_language }}</label>
                    </div>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-default-language-admin" class="col-sm-2 col-form-label">{{ entry_preset_language_admin }}</label>
                  <div class="col-sm-10">
                    <div class="form-check form-switch form-switch-lg">
                      <input type="checkbox" name="language_russian_default_language_admin" value="1" id="input-default-language-admin" class="form-check-input" form="form-language"{% if preset_active.language_admin %} checked{% endif %}/>
                      <label for="input-default-language-admin" class="form-check-label">{{ text_value_language_admin }}</label>
                    </div>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-default-currency" class="col-sm-2 col-form-label">{{ entry_preset_currency }}</label>
                  <div class="col-sm-10">
                    <div class="form-check form-switch form-switch-lg">
                      <input type="checkbox" name="language_russian_default_currency" value="1" id="input-default-currency" class="form-check-input" form="form-language"{% if preset_active.currency %} checked{% endif %}/>
                      <label for="input-default-currency" class="form-check-label">{{ text_value_currency }}</label>
                    </div>
                  </div>
                </div>
              </fieldset>
            </div>
          <div id="tab-translation" class="tab-pane">
            {% if translation_error %}
              <div class="alert alert-warning mt-3">{{ translation_error }}</div>
            {% else %}
              <form id="form-translation" action="{{ translate }}" method="post">
                <div class="d-flex justify-content-between align-items-center mt-3 mb-3">
                  <div class="form-check form-switch form-switch-lg mb-0">
                    <input type="checkbox" id="input-translation-all" class="form-check-input"{% if translation_all %} checked{% endif %}/>
                    <label for="input-translation-all" class="form-check-label">{{ entry_translation_all }}</label>
                  </div>
                  <button type="submit" class="btn btn-primary"><i class="fas fa-language"></i> {{ button_translate }}</button>
                </div>
                <p>{{ text_translation }}</p>
                <div class="accordion" id="accordion-translation">
                  {% for group in translation_groups %}
                    <div class="accordion-item">
                      <h2 class="accordion-header"><button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#collapse-{{ group.code }}">{{ group.title }}</button></h2>
                      <div id="collapse-{{ group.code }}" class="accordion-collapse collapse" data-bs-parent="#accordion-translation">
                        <div class="accordion-body">
                          {% if group.note %}
                            <p>{{ group.note }}</p>
                          {% endif %}
                          {% for section in group.sections %}
                            {% if section.title %}
                              <div class="fw-bold mb-2{% if not loop.first %} mt-4{% endif %}">{{ section.title }}</div>
                            {% endif %}
                            <div class="table-responsive{% if not section.title and not loop.first %} mt-4{% endif %}">
                              <table class="table table-bordered align-middle mb-0">
                                <thead>
                                  <tr>
                                    <th>{{ column_code }}</th>
                                    <th>{{ column_current }}</th>
                                    <th>{{ column_new }}</th>
                                    <th class="text-center">
                                      <div class="form-check form-switch d-inline-block mb-0">
                                        <input type="checkbox" class="form-check-input translation-section-switch"{% if section.all %} checked{% endif %}/>
                                      </div>
                                    </th>
                                  </tr>
                                </thead>
                                <tbody>
                                  {% for row in section.rows %}
                                    <tr data-key="{{ row.key }}">
                                      <td>{{ row.label }}</td>
                                      <td><span class="translation-current">{{ row.current }}</span>{% if section.dual %} / <span class="translation-current-extra">{{ row.current_extra }}</span>{% endif %}</td>
                                      <td>
                                        <input type="text" name="name[{{ row.key }}]" value="{{ row.name }}" placeholder="{{ section.dual ? column_title : column_new }}" class="form-control translation-name"{% if not row.apply %} readonly{% endif %}/>
                                        {% if section.dual %}
                                          <input type="text" name="extra[{{ row.key }}]" value="{{ row.extra }}" placeholder="{{ section.code == 'customer_group' ? column_description : column_unit }}" class="form-control mt-1 translation-extra"{% if not row.apply %} readonly{% endif %}/>
                                        {% endif %}
                                      </td>
                                      <td class="text-center">
                                        <div class="form-check form-switch d-inline-block mb-0">
                                          <input type="checkbox" name="selected[]" value="{{ row.key }}" class="form-check-input translation-switch"{% if row.apply %} checked{% endif %}/>
                                        </div>
                                      </td>
                                    </tr>
                                  {% endfor %}
                                </tbody>
                              </table>
                            </div>
                          {% endfor %}
                        </div>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </form>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
var presetZoneIds = {{ preset_zone_ids|json_encode|raw }};

$('#input-preset').on('change', function() {
    var code = $(this).val();
    var enabled = code !== '';

    $('#input-default-country, #input-default-timezone, #input-default-language, #input-default-language-admin, #input-default-currency').prop('checked', enabled);

    if (code === 'russia') {
        $('#input-preset-zone').val('');
    } else if (presetZoneIds[code]) {
        $('#input-preset-zone').val(String(presetZoneIds[code]));
    }
});

function translationRowState(row) {
    var enabled = row.find('.translation-switch').prop('checked');

    row.find('.translation-name, .translation-extra').prop('readonly', !enabled);
}

function translationSectionState(table) {
    var switches = table.find('.translation-switch');

    table.find('.translation-section-switch').prop('checked', switches.length > 0 && switches.length === switches.filter(':checked').length);
}

function translationMasterState() {
    var switches = $('#form-translation .translation-switch');

    $('#input-translation-all').prop('checked', switches.length > 0 && switches.length === switches.filter(':checked').length);
}

$('#input-translation-all').on('change', function() {
    var enabled = $(this).prop('checked');
    var form = $('#form-translation');

    form.find('.translation-switch, .translation-section-switch').prop('checked', enabled);
    form.find('tbody tr').each(function() {
        translationRowState($(this));
    });
});

$('#form-translation').on('change', '.translation-section-switch', function() {
    var table = $(this).closest('table');
    var enabled = $(this).prop('checked');

    table.find('.translation-switch').prop('checked', enabled);
    table.find('tbody tr').each(function() {
        translationRowState($(this));
    });
    translationMasterState();
});

$('#form-translation').on('change', '.translation-switch', function() {
    translationRowState($(this).closest('tr'));
    translationSectionState($(this).closest('table'));
    translationMasterState();
});

$('#form-translation').on('submit', function(e) {
    e.preventDefault();

    var form = $(this);

    $.ajax({
        url: form.attr('action').replaceAll('&amp;', '&'),
        type: 'post',
        data: form.serialize(),
        dataType: 'json',
        success: function(json) {
            $('.alert-dismissible').remove();

            if (json['error']) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (json['success']) {
                $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');

                $.each(json['rows'], function(_, row) {
                    var line = form.find('tr[data-key="' + row['key'] + '"]');
                    var extra = line.find('.translation-extra');
                    var same = line.find('.translation-name').val() === row['current'];

                    line.find('.translation-current').text(row['current']);

                    if (extra.length) {
                        line.find('.translation-current-extra').text(row['current_extra']);
                        same = same && extra.val() === row['current_extra'];
                    }

                    if (same) {
                        line.find('.translation-switch').prop('checked', false);
                        translationRowState(line);
                    }
                });

                form.find('table').each(function() {
                    translationSectionState($(this));
                });
                translationMasterState();
            }
        }
    });
});
//--></script>
{{ footer }}
