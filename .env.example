# Скопируйте в .env и поправьте пути этой машины.
# Секретов нет. Файл .env не коммитится.
# Версия и тег задаются аргументами build.php, а не этим файлом.

# Корень форка OpenCart (родитель каталога ocn). Пусто — два уровня выше этого файла.
OPENCART_REPO=

# Ветка с upload/**/language/ru-ru. Читается через git archive, checkout не меняется.
OPENCART_BRANCH=lang-v4

# Корень репозитория пакета. Пусто — каталог этого скрипта.
PACKAGE_DIR=
